#!/bin/sh
set -e

udevadm control --reload-rules >/dev/null 2>&1 || true

for runtime_dir in /run/user/[0-9]*; do
  [ -d "$runtime_dir" ] || continue
  uid=${runtime_dir##*/}
  user=$(getent passwd "$uid" | cut -d: -f1)
  [ -n "$user" ] || continue
  runuser -u "$user" -- env XDG_RUNTIME_DIR="$runtime_dir" systemctl --user daemon-reload >/dev/null 2>&1 || true
done

exit 0
